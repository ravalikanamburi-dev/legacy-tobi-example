{
  "schemaVersion": 1,
  "doNotGenerateUntilAsked": true,
  "platform": {
    "family": "ibm-i",
    "objectNameMaxLength": 10
  },
  "buildSystem": {
    "name": "makei",
    "manifest": "Rules.mk",
    "projectFileNames": ["iproj.json"],
    "ccsidFileName": ".ibmi.json",
    "actionsFileName": "actions.json",
    "testConfigFileName": "testing.json",
    "directoryVariable": "$(d)",
    "directoryVariableMeans": "directory containing the manifest",
    "objectTypeSuffixes": [
      "PGM",
      "MODULE",
      "SRVPGM",
      "FILE",
      "CMD",
      "MSGF",
      "MENU",
      "PNLGRP",
      "BNDDIR",
      "DTAARA",
      "DTAQ",
      "TRG",
      "WSCST"
    ]
  },
  "discovery": {
    "ignoreDirectoryNames": [
      ".git",
      ".vs",
      ".cursor",
      "node_modules",
      ".logs",
      ".evfevent",
      "__pycache__"
    ],
    "memberName": {
      "descriptionSeparator": "-",
      "typeTokens": [
        "PGM",
        "MODULE",
        "SRVPGM",
        "FILE",
        "CMD",
        "MSGF",
        "MENU",
        "PNLGRP",
        "BNDDIR",
        "DTAARA",
        "DTAQ",
        "TRG",
        "WSCST"
      ]
    }
  },
  "evidence": {
    "unknownMarker": "NOT EVIDENCED",
    "requireCitation": true,
    "disagreementPolicy": "record-both"
  },
  "package": {
    "outputDirectory": "docs/application",
    "inventoryFile": "docs/application/_inventory.json",
    "templatesDirectory": ".cursor/skills/ibmi-app-documentation/templates"
  },
  "fileNames": {
    "iproj.json": { "class": "project-metadata", "language": "json", "role": "metadata" },
    ".ibmi.json": { "class": "build-metadata", "language": "json", "role": "metadata" },
    "testing.json": { "class": "test-metadata", "language": "json", "role": "metadata" },
    "actions.json": { "class": "build-metadata", "language": "json", "role": "metadata" },
    "rules.mk": { "class": "build-manifest", "language": "make", "role": "build" },
    "readme.md": { "class": "prose", "language": "markdown", "role": "prose" },
    "license": { "class": "license", "language": "text", "role": "license" },
    ".gitignore": { "class": "vcs", "language": "gitignore", "role": "vcs" }
  },
  "extensions": {
    ".rpgle": { "class": "ile-rpg", "language": "RPGLE", "role": "program-source" },
    ".sqlrpgle": { "class": "ile-rpg-sql", "language": "SQLRPGLE", "role": "program-source" },
    ".rpg": { "class": "opm-rpg", "language": "RPG", "role": "program-source" },
    ".sqlrpg": { "class": "opm-rpg-sql", "language": "SQLRPG", "role": "program-source" },
    ".rpgleinc": { "class": "copy-member", "language": "RPGLE", "role": "include" },
    ".rpginc": { "class": "copy-member", "language": "RPG", "role": "include" },
    ".clle": { "class": "clle", "language": "CLLE", "role": "program-source" },
    ".clp": { "class": "clp", "language": "CLP", "role": "program-source" },
    ".cblle": { "class": "cobol", "language": "CBLLE", "role": "program-source" },
    ".cbl": { "class": "cobol", "language": "CBL", "role": "program-source" },
    ".sqlcblle": { "class": "cobol-sql", "language": "SQLCBLLE", "role": "program-source" },
    ".c": { "class": "c", "language": "C", "role": "program-source" },
    ".sqlc": { "class": "c-sql", "language": "SQLC", "role": "program-source" },
    ".cpp": { "class": "cpp", "language": "CPP", "role": "program-source" },
    ".sqlcpp": { "class": "cpp-sql", "language": "SQLCPP", "role": "program-source" },
    ".pf": { "class": "physical-file", "language": "DDS", "role": "definition" },
    ".lf": { "class": "logical-file", "language": "DDS", "role": "definition" },
    ".dspf": { "class": "display-file", "language": "DDS", "role": "definition" },
    ".prtf": { "class": "printer-file", "language": "DDS", "role": "definition" },
    ".pfsql": { "class": "sql-file", "language": "SQL", "role": "definition" },
    ".table": { "class": "sql-table", "language": "SQL", "role": "definition" },
    ".view": { "class": "sql-view", "language": "SQL", "role": "definition" },
    ".sqlprc": { "class": "sql-procedure", "language": "SQL", "role": "program-source" },
    ".sqludf": { "class": "sql-function", "language": "SQL", "role": "program-source" },
    ".sqltrg": { "class": "sql-trigger", "language": "SQL", "role": "definition" },
    ".sqlseq": { "class": "sql-sequence", "language": "SQL", "role": "definition" },
    ".sqlvar": { "class": "sql-variable", "language": "SQL", "role": "definition" },
    ".bnd": { "class": "binder-source", "language": "BND", "role": "definition" },
    ".bnddir": { "class": "binding-directory", "language": "BNDDIR", "role": "definition" },
    ".ilepgm": { "class": "ile-program-script", "language": "CL", "role": "definition" },
    ".ilesrvpgm": { "class": "ile-service-program-script", "language": "CL", "role": "definition" },
    ".cmd": { "class": "command", "language": "CMD", "role": "definition" },
    ".cmdsrc": { "class": "command", "language": "CMD", "role": "definition" },
    ".msgf": { "class": "message-file", "language": "MSGF", "role": "definition" },
    ".menusrc": { "class": "menu", "language": "UIM", "role": "definition" },
    ".pnlgrpsrc": { "class": "panel-group", "language": "UIM", "role": "definition" },
    ".wscstsrc": { "class": "workstation-customizing", "language": "WSCST", "role": "definition" },
    ".systrg": { "class": "system-trigger", "language": "CL", "role": "definition" },
    ".dtaara": { "class": "data-area", "language": "CL", "role": "definition" },
    ".dtaq": { "class": "data-queue", "language": "CL", "role": "definition" },
    ".mk": { "class": "build-manifest", "language": "make", "role": "build" },
    ".md": { "class": "prose", "language": "markdown", "role": "prose" },
    ".json": { "class": "config", "language": "json", "role": "metadata" }
  },
  "packageSections": [
    { "id": "tests", "page": "per-object", "template": "21-test.md", "skill": "ibmi-program-analysis", "match": { "roles": ["test"] } },
    { "id": "screens", "page": "per-object", "template": "09-screen.md", "skill": "ibmi-interface-analysis", "match": { "classes": ["display-file"] } },
    { "id": "reports", "page": "per-object", "template": "10-report.md", "skill": "ibmi-interface-analysis", "match": { "classes": ["printer-file"] } },
    { "id": "commands", "page": "per-object", "template": "11-command.md", "skill": "ibmi-interface-analysis", "match": { "classes": ["command"] } },
    { "id": "menus", "page": "per-object", "template": "12-menu.md", "skill": "ibmi-interface-analysis", "match": { "classes": ["menu"] } },
    { "id": "panels", "page": "per-object", "template": "13-panel-group.md", "skill": "ibmi-interface-analysis", "match": { "classes": ["panel-group"] } },
    { "id": "messages", "page": "per-object", "template": "14-message-file.md", "skill": "ibmi-interface-analysis", "match": { "classes": ["message-file"] } },
    { "id": "workstation-customizing", "page": "per-object", "template": "15-workstation-customizing.md", "skill": "ibmi-interface-analysis", "match": { "classes": ["workstation-customizing"] } },
    { "id": "triggers", "page": "per-object", "template": "16-trigger.md", "skill": "ibmi-build-dependency-analysis", "match": { "classes": ["sql-trigger", "system-trigger"] } },
    { "id": "data-queues", "page": "per-object", "template": "18-data-queue.md", "skill": "ibmi-data-definition-analysis", "match": { "classes": ["data-queue"] } },
    { "id": "data-areas", "page": "per-object", "template": "17-data-area.md", "skill": "ibmi-data-definition-analysis", "match": { "classes": ["data-area"] } },
    { "id": "service-programs", "page": "per-object", "template": "07-service-program.md", "skill": "ibmi-build-dependency-analysis", "match": { "objectTypes": ["SRVPGM"] } },
    { "id": "binding-directories", "page": "per-object", "template": "19-binding-directory.md", "skill": "ibmi-build-dependency-analysis", "match": { "classes": ["binding-directory"] } },
    { "id": "data-stores", "page": "per-object", "template": "08-data-store.md", "skill": "ibmi-data-definition-analysis", "match": { "classes": ["physical-file", "logical-file", "sql-table", "sql-view", "sql-file", "sql-sequence", "sql-variable"] } },
    { "id": "programs", "page": "per-object", "template": "05-program.md", "skill": "ibmi-program-analysis", "match": { "objectTypes": ["PGM"] } },
    { "id": "modules", "page": "per-object", "template": "06-module.md", "skill": "ibmi-program-analysis", "match": { "objectTypes": ["MODULE"] } },
    { "id": "sql-routines", "page": "per-object", "template": "27-sql-routine.md", "skill": "ibmi-data-definition-analysis", "match": { "classes": ["sql-procedure", "sql-function"] } },
    { "id": "copy-members", "page": "per-object", "template": "20-copy-member.md", "skill": "ibmi-program-analysis", "match": { "roles": ["include"] } },
    { "id": "build", "page": "chapter", "template": "02-repository-and-build.md", "skill": "ibmi-build-dependency-analysis", "match": { "roles": ["build", "metadata"] } },
    { "id": "repository-notes", "page": "chapter", "template": "01-system-overview.md", "skill": "ibmi-app-documentation", "match": { "roles": ["prose", "license", "vcs"] } },
    { "id": "unbound-source", "page": "per-object", "template": "26-unbound-source.md", "skill": "ibmi-app-documentation", "match": { "roles": ["program-source", "definition"] } }
  ],
  "chapters": [
    { "id": "index", "template": "00-package-index.md", "skill": "ibmi-app-documentation" },
    { "id": "overview", "template": "01-system-overview.md", "skill": "ibmi-app-documentation" },
    { "id": "build", "template": "02-repository-and-build.md", "skill": "ibmi-build-dependency-analysis" },
    { "id": "functional-areas", "template": "03-functional-areas.md", "skill": "ibmi-app-documentation" },
    { "id": "catalog", "template": "04-object-catalog.md", "skill": "ibmi-source-inventory" },
    { "id": "dependencies", "template": "23-dependencies.md", "skill": "ibmi-build-dependency-analysis" },
    { "id": "globalization", "template": "22-globalization.md", "skill": "ibmi-build-dependency-analysis" },
    { "id": "open-questions", "template": "24-open-questions.md", "skill": "ibmi-app-documentation" },
    { "id": "traceability", "template": "25-traceability.md", "skill": "ibmi-app-documentation" }
  ]
}
